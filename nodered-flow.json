	{
		"id": "0bb4f4540bc10ff6",
		"type": "function",
		"z": "4e91baadad159b60",
		"name": "Brain (charging logic)",
		"func": "const tweakable = msg.tweakable;\nconst deviceId = tweakable && tweakable.DEVICE_ID;\nconst phaseVoltage = Number(tweakable && tweakable.PHASE_VOLTAGE);\nconst targetNetW = Number(tweakable && tweakable.TARGET_NET_W);\nconst maxChangePerCycle = Number(tweakable && tweakable.MAX_CHANGE_PER_CYCLE);\nconst carMinA = Number(tweakable && tweakable.CAR_MIN_A);\n\nconst mode = msg.mode;\nconst p1Power = Number(msg.p1_power);\nconst marstek = Number(msg.marstek_power);\nconst setpoint = Number(msg.current_setpoint);\nconst scheduleState = msg.schedule_active;\nconst scheduleFloorA = Number(msg.schedule_floor_a);\nconst solarMaxA = Number(msg.solar_max_a);\nconst boostMaxA = Number(msg.boost_max_a);\nconst solarOnlyMinA = Number(msg.solar_only_min_a);\nconst solarOnlyMaxA = Number(msg.solar_only_max_a);\n\nconst baseInputs = [phaseVoltage, targetNetW, maxChangePerCycle, carMinA, p1Power, marstek, setpoint];\nif (typeof deviceId !== 'string' || deviceId.trim() === '' || baseInputs.some(value => !Number.isFinite(value))) {\n    node.warn('Charging inputs or tweakable constants are invalid; skipping tick');\n    return null;\n}\n\nif (phaseVoltage <= 0 || maxChangePerCycle <= 0 || carMinA < 1 || carMinA > 32) {\n    node.warn('Tweakable constants are outside their valid ranges; skipping tick');\n    return null;\n}\n\nconst isCarCharging = setpoint >= carMinA;\n\nfunction clamp(value, min, max) {\n    return Math.max(min, Math.min(max, Math.round(value)));\n}\n\nconst netPower = p1Power - marstek;\nconst idealDeltaA = (targetNetW - netPower) / phaseVoltage;\nconst limitedDeltaA = Math.abs(idealDeltaA) < 1\n    ? 0\n    : clamp(idealDeltaA, -maxChangePerCycle, maxChangePerCycle);\n\nfunction targetA(currentA, floorA, maxA) {\n    if (floorA >= carMinA) {\n        return clamp(currentA + limitedDeltaA, floorA, maxA);\n    }\n\n    if (isCarCharging) {\n        let raw = clamp(currentA + limitedDeltaA, floorA, maxA);\n        if (raw > 0 && raw < carMinA) {\n            const idealTarget = currentA + idealDeltaA;\n            raw = idealTarget <= 0 ? 0 : carMinA;\n        }\n        return raw;\n    }\n\n    return idealDeltaA >= carMinA ? carMinA : 0;\n}\n\nif (mode === 'Default') {\n    if (scheduleState !== 'on' && scheduleState !== 'off') {\n        node.warn('Schedule state is unavailable or invalid; skipping tick');\n        return null;\n    }\n\n    if (!Number.isFinite(scheduleFloorA) || !Number.isFinite(solarMaxA) ||\n        scheduleFloorA < 0 || scheduleFloorA > 32 || solarMaxA < 0 || solarMaxA > 32) {\n        node.warn('Default-mode amperage settings are invalid; skipping tick');\n        return null;\n    }\n\n    const floorA = scheduleState === 'on' ? scheduleFloorA : 0;\n    const ceilingA = Math.max(solarMaxA, floorA);\n    msg.payload = { new_current: targetA(setpoint, floorA, ceilingA), device_id: deviceId };\n    return msg;\n}\n\nif (mode === 'Boost') {\n    if (!Number.isFinite(boostMaxA) || boostMaxA < 0 || boostMaxA > 32) {\n        node.warn('Boost maximum is invalid; skipping tick');\n        return null;\n    }\n\n    msg.payload = { new_current: boostMaxA, device_id: deviceId };\n    return msg;\n}\n\nif (mode === 'Solar only') {\n    if (!Number.isFinite(solarOnlyMinA) || !Number.isFinite(solarOnlyMaxA) ||\n        solarOnlyMinA < 0 || solarOnlyMaxA > 32 || solarOnlyMinA > solarOnlyMaxA) {\n        node.warn('Solar-only amperage settings are invalid; skipping tick');\n        return null;\n    }\n\n    msg.payload = { new_current: targetA(setpoint, solarOnlyMinA, solarOnlyMaxA), device_id: deviceId };\n    return msg;\n}\n\nnode.warn('Unknown mode: ' + mode);\nreturn null;",
		"outputs": 1,
		"timeout": "",
		"noerr": 0,
		"initialize": "",
		"finalize": "",
